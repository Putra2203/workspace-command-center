generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model QueryCache {
  key       String   @id
  value     Json
  expiresAt DateTime @map("expires_at")

  @@map("query_cache")
}

model ActionPlanAuditLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  intent       String
  summary      String
  risk         String
  approvedAt   DateTime @default(now()) @map("approved_at")
  stepsJson    Json     @map("steps_json")
  resultJson   Json     @map("result_json")
  successCount Int      @map("success_count")
  failCount    Int      @map("fail_count")

  @@map("action_plan_audit_log")
}

model InboxItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  rawText   String   @map("raw_text")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("inbox_items")
}

model AutomationRule {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  trigger   String
  action    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("automation_rules")
}

model AiUsage {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  feature      String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  totalTokens  Int      @map("total_tokens")
  durationMs   Int      @map("duration_ms")
  success      Boolean  @default(true)
  error        String?

  @@map("ai_usage")
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String        @default("New Conversation")
  projectId String?       @map("project_id")
  userId    String?       @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  messages  ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String      @map("session_id")
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String      // 'user' | 'assistant'
  content     String      @db.Text
  actionCards Json?       @map("action_cards")
  plan        Json?
  imageUrl    String?     @map("image_url")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}
